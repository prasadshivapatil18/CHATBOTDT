# Environment Configuration
ENVIRONMENT=development
APP_NAME="Sidekick AI Customer Service"
DATABASE_URL=sqlite:///./retail_support.db

# LLM Configuration
# Leave OPENAI_API_KEY blank to run in fully-functional Intelligent Demo Mode.
# Provide a valid OpenAI key (e.g. sk-...) to activate live GPT-4o-mini tool calling.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEMO_MODE=True

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
